# Backend env vars for Render or local cloud-mode testing.
# Do not commit a real .env file with secrets.

# Render usually cannot reach Supabase Direct connections because they resolve to IPv6.
# Use Supabase Session Pooler for Render.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD_URL_ENCODED>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Set this to your exact Vercel frontend origin after deployment.
ALLOWED_ORIGIN=https://your-vercel-app.vercel.app

# Optional. Defaults are already handled by the backend in cloud mode.
MODEL_DIR=/tmp/models
FACE_CACHE_DIR=/tmp/faces
