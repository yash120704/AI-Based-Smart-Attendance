# Backend env vars for Render or local cloud-mode testing.
# Do not commit a real .env file with secrets.

DATABASE_URL=postgresql://postgres:<PASSWORD_URL_ENCODED>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Set this to your exact Vercel frontend origin after deployment.
ALLOWED_ORIGIN=https://your-vercel-app.vercel.app

# Optional. Defaults are already handled by the backend in cloud mode.
MODEL_DIR=/tmp/models
FACE_CACHE_DIR=/tmp/faces
